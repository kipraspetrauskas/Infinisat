  "extraction_methods": [
    {
      "tool": "UABEA (Asset Bundle Editor)",
      "url": "https://github.com/AssetRipper/UABEA/releases",
      "steps": [
        "Download and extract UABEA",
        "Run UABEA.exe",
        "File -> Open -> Select resources.assets",
        "Expand Container in tree view",
        "Search for model name (JWST, Hubble, etc.)",
        "Right-click prefab -> Export -> Choose .fbx format",
        "Save to extraction folder"
      ]
    },
    {
      "tool": "AssetRipper",
      "url": "https://github.com/AssetRipper/AssetRipper/releases",
      "steps": [
        "Download and install AssetRipper",
        "File -> Import -> Data Folder",
        "Select the data folder containing asset files",
        "Wait for import (5-10 minutes)",
        "Navigate to Resources/Prefabs/SpaceCraft/",
        "Right-click model -> Export All -> .fbx with textures"
      ]
    }
  ],
